---
/**
 * Word, how to say it, what it means. Pronunciation goes wherever a new word
 * appears — the teacher is reading this aloud.
 */
export interface Word { term: string; say?: string; gloss?: string; }
interface Props {
  words: Word[];
  pairs?: boolean;
  /**
   * The language of the `term` column, as a BCP 47 tag.
   *
   * Only the terms: `say` is an English respelling of a foreign sound and
   * `gloss` is the English meaning, so neither is in that language and
   * marking them would be a lie to a screen reader.
   *
   * The French section passes "fr", which is also what puts a speaker beside
   * each word — see `sayfrench.ts`. The Italian pages pass nothing, which is
   * why they stay silent.
   */
  lang?: string;
}
const { words, pairs = false, lang } = Astro.props;
---
<table class:list={["words", pairs && "pairs"]}>
  <tbody>
    {words.map((w) => (
      <tr>
        <td class="term" lang={lang} set:html={w.term} />
        {w.say !== undefined && <td class="say" set:html={w.say} />}
        {w.gloss !== undefined && <td class="gloss" set:html={w.gloss} />}
      </tr>
    ))}
  </tbody>
</table>
