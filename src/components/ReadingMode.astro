---
/**
 * "Just what I need" — a switch that takes the commentary out of the way.
 *
 * A revision pack carries three kinds of writing: the words, the rule that
 * holds them together, and the asides that explain why the rule is the way it
 * is. About a third of the prose is that third kind, and on the fifth time
 * through it is in the way — a child on a revision run wants the table and the
 * practice, not a paragraph about why the numbers stop at thirty-one.
 *
 * So it is a switch rather than a rewrite. Nothing is deleted:
 *
 *   - Notes written for the parent disappear. They were never his.
 *   - Notes written for him fold up to their heading, one tap from open.
 *   - The rules, the words and the practice are untouched, because those are
 *     what he came for.
 *
 * It remembers the choice for the whole French section, so it is set once
 * rather than on every page. Default is everything shown, which is what a
 * parent opening it for the first time should see — and what a browser with no
 * JavaScript always sees.
 */
---
<div class="readingmode noprint">
  <label>
    <input type="checkbox" id="plainmode" />
    <span>Just what I need</span>
  </label>
  <span class="hint">hides the notes for whoever is helping</span>
</div>

<script is:inline>
  // Inline and immediate: run from the bundle and the page would paint the
  // notes before hiding them, which is a flash of the exact thing the switch
  // exists to remove.
  (function () {
    var KEY = "fr7:plain";
    var root = document.documentElement;
    var on = false;
    try { on = window.localStorage.getItem(KEY) === "1"; } catch (e) { /* no storage */ }

    function apply(value) {
      if (value) root.setAttribute("data-plain", "");
      else root.removeAttribute("data-plain");
      // A folded note is a <details> with its `open` taken away, so the
      // heading stays and the body is one tap from coming back.
      var asides = document.querySelectorAll("details.aside");
      for (var i = 0; i < asides.length; i++) asides[i].open = !value;
    }

    apply(on);

    document.addEventListener("DOMContentLoaded", function () {
      var box = document.getElementById("plainmode");
      if (!box) return;
      box.checked = on;
      apply(on);
      box.addEventListener("change", function () {
        apply(this.checked);
        try { window.localStorage.setItem(KEY, this.checked ? "1" : "0"); } catch (e) {
          /* the choice holds for this page and is forgotten; nothing breaks */
        }
      });
    });
  })();
</script>

<style>
  .readingmode {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.7rem;
    font-family: var(--sans); font-size: 0.84rem;
    margin: 0 0 1.3rem;
  }
  .readingmode label {
    display: inline-flex; align-items: center; gap: 0.45rem;
    cursor: pointer; color: var(--ink);
  }
  .readingmode input { width: 1rem; height: 1rem; accent-color: var(--accent); }
  .readingmode .hint { font-size: 0.74rem; color: var(--ink-faint); }
</style>
