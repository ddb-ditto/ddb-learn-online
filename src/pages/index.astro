---
/**
 * The front door, and nothing else.
 *
 * Two people use this site for two unrelated things, so the first page asks
 * which one rather than stacking both and making each of them scroll past the
 * other. Everything the Italian course had here moved to /italian/ unchanged.
 *
 * The counts are read from the content rather than written down, so a door
 * never advertises something that is not behind it.
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const units = await getCollection("units");
const sessions = await getCollection("sessions");
const packs = await getCollection("frenchPacks");
const tests = (await getCollection("frenchTests")).sort(
  (a, b) => a.data.order - b.data.order,
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/** Days until the next test that has not happened, or null once they are past. */
const DAY = 24 * 60 * 60 * 1000;
const midnight = (d: Date) =>
  Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
const today = midnight(new Date());
const next = tests
  .map((t) => ({
    title: t.data.title,
    days: Math.round((midnight(new Date(`${t.data.date}T00:00:00Z`)) - today) / DAY),
  }))
  .filter((t) => t.days >= 0)
  .sort((a, b) => a.days - b.days)[0];

const soon =
  next === undefined ? null :
  next.days === 0 ? `${next.title} today` :
  next.days === 1 ? `${next.title} tomorrow` :
  `${next.title} in ${next.days} days`;

const doors = [
  {
    href: `${base}/italian/`,
    kicker: "Two-year course",
    title: "Italian",
    blurb: "GCSE Italian taught at home, unit by unit — lesson plans, flashcards and printable record sheets.",
    count: `${units.length} unit${units.length === 1 ? "" : "s"} built · ${sessions.length} sessions`,
    flag: null as string | null,
  },
  {
    href: `${base}/french/year-7/`,
    kicker: "School revision",
    title: "Year 7 French",
    blurb: "Revision for the class tests — the words, the rules, flashcards, and practice that marks itself.",
    count: `${packs.length} packs · ${tests.length} tests`,
    flag: soon,
  },
];
---
<Base
  banner
  title="Lessons and flashcards"
  description="Lesson pages, flashcards and printable sheets: a two-year Pearson Edexcel GCSE Italian course taught at home, and Year 7 French revision."
>
  <nav class="doors" aria-label="Subjects">
    {doors.map((d) => (
      <a class="door" href={d.href}>
        <span class="kicker">{d.kicker}</span>
        <span class="title">{d.title}</span>
        <span class="blurb">{d.blurb}</span>
        <span class="foot">
          <span class="count">{d.count}</span>
          {d.flag && <span class="flag">{d.flag}</span>}
        </span>
      </a>
    ))}
  </nav>

  <footer slot="footer">
    <span>Pearson Edexcel GCSE Italian 1IN0 · Year 7 French</span>
    <span>Taught at home</span>
  </footer>
</Base>
