---
/**
 * Every page on the site. The house stylesheet is imported here and bundled
 * once, so a page costs its own markup and nothing else.
 */
import "../styles/house.css";
import ThemeSwitch from "../components/ThemeSwitch.astro";

interface Props {
  title: string;
  eyebrow?: string;
  heading?: string;
  standfirst?: string;
  description?: string;
  /**
   * Which mark to show, on the way in. Above a lesson any of them would
   * compete with the material rather than introduce it, so only the three
   * front pages pass one.
   *
   * "site" is the DDB wordmark and belongs to the whole site, so it goes on
   * the front door. "italian" is the GCSE Italian mark, which says so on its
   * face, and belongs to that course's contents page. "french" is the Year 7
   * mark and belongs to that section's, the same way — not to a pack, where
   * the breadcrumb D is the only branding.
   */
  logo?: "site" | "italian" | "french";
  /**
   * The front door's banner: artwork across the top of the window, in place
   * of a mark rather than as well as one. See BANNER below for why it is not
   * one of the three.
   */
  banner?: boolean;
}

const { title, eyebrow, heading, standfirst, description, logo,
        banner = false } = Astro.props;

const MARKS = {
  site: { src: "logo-site.png", w: 600, h: 355, alt: "DDB Learn online" },
  italian: { src: "logo.png", w: 600, h: 327, alt: "Italian GCSE" },
  french: { src: "logo-french.png", w: 600, h: 457, alt: "Year 7 French" },
} as const;
const mark = logo ? MARKS[logo] : null;

/**
 * The front door's banner: artwork that spans the window above everything.
 *
 * Deliberately not a fourth entry in MARKS. The three marks are cut out of
 * the card they were drawn on and placed on a dark band, because they are
 * lettering with no ground of its own. This has a ground — it is a picture —
 * so it is never keyed, never quantised, and never sits on `.on-dark`: a
 * fixed navy strip behind an image that fills the strip is a colour nobody
 * can see, and on the page's own paper the edges follow the theme like
 * everything else.
 */
const BANNER = { w: 2048, h: 1120, alt: "DDB Learn Online" };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/**
 * The mark's attributes, written once and used in both places it can appear.
 *
 * A page with a heading shows the mark above it. A page with no heading — the
 * front door, where the mark says the site's name better than a line of type
 * could — puts the mark *inside* the h1 instead, so the page still has one
 * and its accessible name is the mark's alt text. A front page with no h1 at
 * all is the alternative, and that is worse for anybody arriving by search or
 * by screen reader.
 */
const markAttrs = mark
  ? {
      class: `logomark is-${logo}`,
      src: `${base}/${mark.src}`,
      width: mark.w,
      height: mark.h,
      alt: mark.alt,
    }
  : null;

/**
 * Which commit built this page. GitHub Pages serves HTML with a ten-minute
 * cache, so a page in front of you can be several deploys old — and a stale
 * page is indistinguishable from a bug until you can see which one it is.
 */
const build = (process.env.GITHUB_SHA ?? "local").slice(0, 7);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" sizes="32x32" href={`${base}/favicon-32.png`} type="image/png" />
  <link rel="icon" sizes="16x16" href={`${base}/favicon-16.png`} type="image/png" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <link rel="manifest" href={`${base}/manifest.webmanifest`} />
  {/* The brand navy: this colours the browser chrome, which is the
      site's frame rather than the Italian course's. */}
  <meta name="theme-color" content="#021229" />

  {/*
    Applies a saved light/dark choice before the first paint.

    It has to be here, inline and blocking, rather than in the bundle: run it
    a moment later and a page someone has set to dark arrives white and then
    turns, which is worse than not offering the choice. Nothing is set when
    the choice is "match my device" — the stylesheet's media query handles
    that, and so a browser with no JavaScript still follows the device.
  */}
  <script is:inline>
    /**
     * Open every folded note while the page is being printed.
     *
     * The notes on the French pages are closed by default, and a browser
     * prints a closed <details> as its heading alone — so without this a
     * printed pack loses every note it has. No CSS rule on the children
     * reaches it, because what the browser leaves unrendered is the
     * element's own content slot; `::details-content` addresses that slot
     * but is recent, so the stylesheet handles the browsers that have it and
     * this handles the rest.
     *
     * Restored afterwards, or the page he goes back to is not the one he
     * left. matchMedia is listened to as well as beforeprint because a print
     * *preview* changes the media without firing the event.
     */
    (function () {
      var opened = [];
      function open() {
        opened = [].slice.call(
          document.querySelectorAll("details.note.aside:not([open])"));
        for (var i = 0; i < opened.length; i++) opened[i].open = true;
      }
      function shut() {
        for (var i = 0; i < opened.length; i++) opened[i].open = false;
        opened = [];
      }
      window.addEventListener("beforeprint", open);
      window.addEventListener("afterprint", shut);
      if (window.matchMedia) {
        var mq = window.matchMedia("print");
        var changed = function (e) { if (e.matches) { open(); } else { shut(); } };
        if (mq.addEventListener) mq.addEventListener("change", changed);
        else if (mq.addListener) mq.addListener(changed);
      }
    })();
  </script>

  <script is:inline>
    (function () {
      try {
        var saved = window.localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      } catch (e) { /* no storage: fall through to the device's setting */ }
    })();
  </script>
  <meta name="build" content={build} />
  <meta name="mobile-web-app-capable" content="yes" />
</head>
<body>

{(heading || mark || banner) && (
  <header class:list={["masthead", mark && "on-dark", banner && "has-banner"]}>
    {banner && (
      <h1 class="bannerhead">
        <img
          class="banner"
          src={`${base}/banner-1024.webp`}
          srcset={`${base}/banner-1024.webp 1024w, ${base}/banner-2048.webp 2048w`}
          sizes="100vw"
          width={BANNER.w}
          height={BANNER.h}
          alt={BANNER.alt}
          fetchpriority="high"
        />
      </h1>
    )}
    <div class="masthead-inner">
      {markAttrs && !heading && <h1 class="markhead"><img {...markAttrs} /></h1>}
      {markAttrs && heading && <img {...markAttrs} />}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {heading && <h1>{heading}</h1>}
      {standfirst && <p class="standfirst" set:html={standfirst} />}
    </div>
  </header>
)}

<slot name="nav" />

<main>
  <slot />
  <slot name="footer" />
  <ThemeSwitch />
</main>

</body>
</html>
